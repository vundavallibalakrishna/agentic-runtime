{
  "apiVersion": "agentic-runtime.dev/v1",
  "kind": "ContentPack",
  "metadata": {
    "id": "records",
    "version": "1.0.0",
    "name": "Records",
    "minPlatform": "1.0.0"
  },
  "spec": {
    "resources": [],
    "extension": {
      "entry": "records_pack",
      "permissions": [
        "evidence:read",
        "evidence:capture",
        "evidence:export",
        "holds:manage",
        "retention:manage",
        "ai_governance:read",
