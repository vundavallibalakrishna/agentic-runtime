              "type": "null"
            }
          ],
          "default": null,
          "title": "Risk Tier"
        },
        "alias": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Alias"
        }
      },
      "title": "Metadata",
      "type": "object"
    },
