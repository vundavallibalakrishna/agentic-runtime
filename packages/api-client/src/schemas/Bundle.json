{
  "$defs": {
    "AgentDefinition": {
      "additionalProperties": false,
      "description": "Versioned body stored in ``agent_versions.definition``.",
      "properties": {
        "persona": {
          "$ref": "#/$defs/Persona"
        },
        "instructions": {
          "maxLength": 32000,
          "minLength": 1,
          "title": "Instructions",
          "type": "string"
        },
        "starterPrompts": {
          "items": {
            "type": "string"
          },
          "maxItems": 6,
          "title": "Starterprompts",
          "type": "array"
        },
        "model": {
          "$ref": "#/$defs/ModelSpec"
        },
        "tools": {
          "items": {
            "$ref": "#/$defs/ToolBinding"
          },
          "title": "Tools",
          "type": "array"
        },
        "toolSearch": {
          "$ref": "#/$defs/ToolSearch",
          "default": {
            "mode": "auto",
            "topK": 12
          }
        },
        "knowledge": {
          "$ref": "#/$defs/KnowledgeSpec",
          "default": {
            "collections": [],
            "autoRetrieve": false,
            "topK": 8,
            "minScore": 0.3
          }
        },
        "skills": {
          "items": {
            "type": "string"
          },
          "maxItems": 50,
          "title": "Skills",
          "type": "array"
        },
        "memory": {
          "$ref": "#/$defs/MemorySpec",
          "default": {
            "enabled": true,
            "readScopes": [
              "user",
              "agent"
            ],
            "userWrites": "auto",
            "agentWrites": "review",
            "recallTopK": 8
          }
        },
        "subagents": {
          "$ref": "#/$defs/SubagentSpec",
          "default": {
            "allowed": [],
            "allowSelfClone": false,
            "maxDepth": 1,
            "maxParallel": 3
          }
        },
        "sandbox": {
          "$ref": "#/$defs/SandboxSpec",
          "default": {
            "enabled": false,
            "template": "default",
            "scope": "conversation",
            "extraEgressAllowlist": []
          }
        },
        "budget": {
          "$ref": "#/$defs/RunBudget"
        },
        "context": {
          "$ref": "#/$defs/ContextSpec",
          "default": {
            "compactionThreshold": 0.7,
            "toolResultMaxTokens": 4000,
            "historyMaxMessages": 40
          }
        },
        "output": {
          "$ref": "#/$defs/OutputSpec",
          "default": {
            "citations": "preferred",
            "showReasoning": false
          }
        },
        "safety": {
          "$ref": "#/$defs/SafetySpec",
          "default": {
            "piiMasking": false,
            "injectionClassifier": true
          }
        },
        "channels": {
          "$ref": "#/$defs/ChannelFlags",
          "default": {
            "web": true,
            "slack": false,
            "teams": false,
            "email": false,
            "api": true,
            "widget": false
          }
        }
      },
      "required": [
        "persona",
        "instructions",
        "model",
        "budget"
      ],
      "title": "AgentDefinition",
      "type": "object"
    },
    "AgentResource": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "Agent",
          "title": "Kind",
          "type": "string"
        },
        "metadata": {
          "$ref": "#/$defs/Metadata"
        },
        "spec": {
          "$ref": "#/$defs/AgentDefinition"
        }
      },
      "required": [
        "kind",
        "metadata",
        "spec"
      ],
      "title": "AgentResource",
      "type": "object"
    },
    "ChannelFlags": {
      "additionalProperties": false,
      "properties": {
        "web": {
          "default": true,
          "title": "Web",
          "type": "boolean"
        },
        "slack": {
          "default": false,
          "title": "Slack",
          "type": "boolean"
        },
        "teams": {
          "default": false,
          "title": "Teams",
          "type": "boolean"
        },
        "email": {
          "default": false,
          "title": "Email",
          "type": "boolean"
        },
        "api": {
          "default": true,
          "title": "Api",
          "type": "boolean"
        },
        "widget": {
          "default": false,
          "title": "Widget",
          "type": "boolean"
        }
      },
      "title": "ChannelFlags",
      "type": "object"
    },
    "ChannelIntegrationDefinition": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "slack",
            "teams",
            "email",
            "widget"
          ],
          "title": "Kind",
          "type": "string"
        },
        "secret": {
          "title": "Secret",
          "type": "string"
        },
        "defaultAgent": {
          "title": "Defaultagent",
          "type": "string"
        },
        "config": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Config",
          "type": "object"
        }
      },
      "required": [
        "kind",
        "secret",
        "defaultAgent"
      ],
      "title": "ChannelIntegrationDefinition",
      "type": "object"
    },
    "ChannelIntegrationResource": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "ChannelIntegration",
          "title": "Kind",
          "type": "string"
        },
        "metadata": {
          "$ref": "#/$defs/Metadata"
        },
        "spec": {
          "$ref": "#/$defs/ChannelIntegrationDefinition"
        }
      },
      "required": [
        "kind",
        "metadata",
        "spec"
      ],
      "title": "ChannelIntegrationResource",
      "type": "object"
    },
    "ContextSpec": {
      "additionalProperties": false,
      "properties": {
        "compactionThreshold": {
          "default": 0.7,
          "maximum": 0.9,
          "minimum": 0.4,
          "title": "Compactionthreshold",
          "type": "number"
        },
        "toolResultMaxTokens": {
          "default": 4000,
          "minimum": 1,
          "title": "Toolresultmaxtokens",
          "type": "integer"
        },
        "historyMaxMessages": {
          "default": 40,
          "minimum": 1,
          "title": "Historymaxmessages",
          "type": "integer"
        }
      },
      "title": "ContextSpec",
      "type": "object"
    },
    "DataConnectionDefinition": {
      "additionalProperties": false,
      "properties": {
        "engine": {
          "const": "postgres",
          "default": "postgres",
          "title": "Engine",
          "type": "string"
        },
        "dsnSecret": {
          "title": "Dsnsecret",
          "type": "string"
        },
        "identityMode": {
          "default": "service",
          "enum": [
            "service",
            "per_user_mapped",
            "passthrough"
          ],
          "title": "Identitymode",
          "type": "string"
        },
        "allowlistSchemas": {
          "items": {
            "type": "string"
          },
          "title": "Allowlistschemas",
          "type": "array"
        },
        "allowlistTables": {
          "items": {
            "type": "string"
          },
          "title": "Allowlisttables",
          "type": "array"
        },
        "columnsDeny": {
          "items": {
            "type": "string"
          },
          "title": "Columnsdeny",
          "type": "array"
        },
        "rowLimit": {
          "default": 1000,
          "minimum": 1,
          "title": "Rowlimit",
          "type": "integer"
        },
        "statementTimeoutS": {
          "default": 30,
          "minimum": 1,
          "title": "Statementtimeouts",
          "type": "integer"
        },
        "classification": {
          "default": "internal",
          "title": "Classification",
          "type": "string"
        },
        "schemaNotes": {
          "default": "",
          "title": "Schemanotes",
          "type": "string"
        }
      },
      "required": [
        "dsnSecret"
      ],
      "title": "DataConnectionDefinition",
      "type": "object"
    },
    "DataConnectionResource": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "DataConnection",
          "title": "Kind",
          "type": "string"
        },
        "metadata": {
          "$ref": "#/$defs/Metadata"
        },
        "spec": {
          "$ref": "#/$defs/DataConnectionDefinition"
        }
      },
      "required": [
        "kind",
        "metadata",
        "spec"
      ],
      "title": "DataConnectionResource",
      "type": "object"
    },
    "DeliveryTarget": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "conversation",
            "slack",
            "teams",
            "email",
            "webhook",
            "file"
          ],
          "title": "Type",
          "type": "string"
        },
        "integration": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Integration"
        },
        "channel": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Channel"
        },
        "preApproved": {
          "default": false,
          "title": "Preapproved",
          "type": "boolean"
        },
        "config": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Config",
          "type": "object"
        }
      },
      "required": [
        "type"
      ],
      "title": "DeliveryTarget",
      "type": "object"
    },
