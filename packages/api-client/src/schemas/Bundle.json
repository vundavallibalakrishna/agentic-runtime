        "chunkTargetTokens": {
          "default": 512,
          "minimum": 64,
          "title": "Chunktargettokens",
          "type": "integer"
        },
        "chunkOverlapPct": {
          "default": 12,
          "maximum": 50,
          "minimum": 0,
          "title": "Chunkoverlappct",
          "type": "integer"
        },
        "contextual": {
          "default": false,
          "title": "Contextual",
          "type": "boolean"
        },
        "sources": {
          "items": {
            "$ref": "#/$defs/KnowledgeSource"
