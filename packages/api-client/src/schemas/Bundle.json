          "title": "Read Scopes",
          "type": "array"
        },
        "user_writes": {
          "default": "auto",
          "enum": [
            "auto",
            "explicit_only",
            "off"
          ],
          "title": "User Writes",
          "type": "string"
        },
        "agent_writes": {
          "default": "review",
          "enum": [
            "review",
            "off"
          ],
          "title": "Agent Writes",
          "type": "string"
        },
        "recall_top_k": {
          "default": 8,
          "minimum": 1,
          "title": "Recall Top K",
          "type": "integer"
        }
      },
      "title": "MemorySpec",
      "type": "object"
    },
    "Metadata": {
      "additionalProperties": false,
      "properties": {
        "slug": {
          "anyOf": [
            {
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Slug"
        },
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "visibility": {
          "anyOf": [
            {
              "enum": [
                "private",
                "team",
                "tenant"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Visibility"
