        },
        "config": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Config",
          "type": "object"
        }
      },
      "required": [
        "name",
        "kind"
      ],
      "title": "KnowledgeSource",
      "type": "object"
    },
    "KnowledgeSpec": {
      "additionalProperties": false,
      "properties": {
        "collections": {
          "items": {
            "type": "string"
          },
          "maxItems": 20,
          "title": "Collections",
          "type": "array"
        },
        "auto_retrieve": {
          "default": false,
          "title": "Auto Retrieve",
          "type": "boolean"
        },
        "top_k": {
          "default": 8,
          "minimum": 1,
          "title": "Top K",
          "type": "integer"
        },
        "min_score": {
          "default": 0.3,
          "maximum": 1,
          "minimum": 0,
          "title": "Min Score",
          "type": "number"
        }
      },
      "title": "KnowledgeSpec",
      "type": "object"
    },
    "MemorySpec": {
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        },
        "read_scopes": {
          "items": {
            "enum": [
              "user",
