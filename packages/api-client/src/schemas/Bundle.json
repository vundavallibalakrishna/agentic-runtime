{
  "$defs": {
    "AgentDefinition": {
      "additionalProperties": false,
      "description": "Versioned body stored in ``agent_versions.definition``.",
      "properties": {
        "persona": {
          "$ref": "#/$defs/Persona"
        },
        "instructions": {
          "maxLength": 32000,
          "minLength": 1,
          "title": "Instructions",
          "type": "string"
        },
        "starter_prompts": {
          "items": {
            "type": "string"
          },
          "maxItems": 6,
          "title": "Starter Prompts",
          "type": "array"
        },
        "model": {
          "$ref": "#/$defs/ModelSpec"
        },
        "tools": {
          "items": {
            "$ref": "#/$defs/ToolBinding"
          },
          "title": "Tools",
          "type": "array"
        },
        "tool_search": {
          "$ref": "#/$defs/ToolSearch",
          "default": {
            "mode": "auto",
            "top_k": 12
          }
        },
        "knowledge": {
          "$ref": "#/$defs/KnowledgeSpec",
          "default": {
            "collections": [],
            "auto_retrieve": false,
            "top_k": 8,
            "min_score": 0.3
          }
        },
        "skills": {
          "items": {
            "type": "string"
          },
          "maxItems": 50,
          "title": "Skills",
          "type": "array"
        },
        "memory": {
          "$ref": "#/$defs/MemorySpec",
          "default": {
            "enabled": true,
            "read_scopes": [
              "user",
              "agent"
            ],
            "user_writes": "auto",
            "agent_writes": "review",
            "recall_top_k": 8
          }
        },
        "subagents": {
          "$ref": "#/$defs/SubagentSpec",
          "default": {
            "allowed": [],
            "allow_self_clone": false,
            "max_depth": 1,
            "max_parallel": 3
          }
        },
        "sandbox": {
          "$ref": "#/$defs/SandboxSpec",
          "default": {
            "enabled": false,
            "template": "default",
            "scope": "conversation",
            "extra_egress_allowlist": []
          }
        },
        "budget": {
          "$ref": "#/$defs/RunBudget"
        },
        "context": {
          "$ref": "#/$defs/ContextSpec",
          "default": {
            "compaction_threshold": 0.7,
            "tool_result_max_tokens": 4000,
            "history_max_messages": 40
          }
        },
        "output": {
          "$ref": "#/$defs/OutputSpec",
          "default": {
            "citations": "preferred",
            "show_reasoning": false
          }
        },
        "safety": {
          "$ref": "#/$defs/SafetySpec",
          "default": {
            "pii_masking": false,
            "injection_classifier": true
          }
        },
        "channels": {
          "$ref": "#/$defs/ChannelFlags",
          "default": {
            "web": true,
            "slack": false,
            "teams": false,
            "email": false,
            "api": true,
            "widget": false
          }
        }
      },
      "required": [
        "persona",
        "instructions",
        "model",
        "budget"
      ],
      "title": "AgentDefinition",
      "type": "object"
    },
    "AgentResource": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "Agent",
          "title": "Kind",
          "type": "string"
        },
        "metadata": {
          "$ref": "#/$defs/Metadata"
        },
        "spec": {
          "$ref": "#/$defs/AgentDefinition"
        }
      },
      "required": [
        "kind",
        "metadata",
        "spec"
      ],
      "title": "AgentResource",
      "type": "object"
    },
    "ChannelFlags": {
      "additionalProperties": false,
      "properties": {
        "web": {
          "default": true,
          "title": "Web",
          "type": "boolean"
        },
        "slack": {
          "default": false,
          "title": "Slack",
          "type": "boolean"
        },
        "teams": {
          "default": false,
          "title": "Teams",
          "type": "boolean"
        },
        "email": {
          "default": false,
          "title": "Email",
          "type": "boolean"
        },
        "api": {
          "default": true,
          "title": "Api",
          "type": "boolean"
        },
        "widget": {
          "default": false,
          "title": "Widget",
          "type": "boolean"
        }
      },
      "title": "ChannelFlags",
      "type": "object"
    },
    "ChannelIntegrationDefinition": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "slack",
            "teams",
            "email",
            "widget"
          ],
          "title": "Kind",
          "type": "string"
        },
        "secret": {
          "title": "Secret",
          "type": "string"
        },
        "default_agent": {
          "title": "Default Agent",
          "type": "string"
        },
        "config": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Config",
          "type": "object"
        }
      },
      "required": [
        "kind",
        "secret",
        "default_agent"
      ],
      "title": "ChannelIntegrationDefinition",
      "type": "object"
    },
    "ChannelIntegrationResource": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "ChannelIntegration",
          "title": "Kind",
          "type": "string"
        },
        "metadata": {
          "$ref": "#/$defs/Metadata"
        },
        "spec": {
          "$ref": "#/$defs/ChannelIntegrationDefinition"
        }
      },
      "required": [
        "kind",
        "metadata",
        "spec"
      ],
      "title": "ChannelIntegrationResource",
      "type": "object"
    },
    "ContextSpec": {
      "additionalProperties": false,
      "properties": {
        "compaction_threshold": {
          "default": 0.7,
          "maximum": 0.9,
          "minimum": 0.4,
          "title": "Compaction Threshold",
          "type": "number"
        },
        "tool_result_max_tokens": {
          "default": 4000,
          "minimum": 1,
          "title": "Tool Result Max Tokens",
          "type": "integer"
        },
        "history_max_messages": {
          "default": 40,
          "minimum": 1,
          "title": "History Max Messages",
          "type": "integer"
        }
      },
      "title": "ContextSpec",
      "type": "object"
    },
    "DataConnectionDefinition": {
      "additionalProperties": false,
      "properties": {
        "engine": {
          "const": "postgres",
          "default": "postgres",
          "title": "Engine",
          "type": "string"
        },
        "dsn_secret": {
          "title": "Dsn Secret",
          "type": "string"
        },
        "identity_mode": {
          "default": "service",
          "enum": [
            "service",
            "per_user_mapped",
            "passthrough"
          ],
          "title": "Identity Mode",
          "type": "string"
        },
        "allowlist_schemas": {
          "items": {
            "type": "string"
          },
          "title": "Allowlist Schemas",
          "type": "array"
        },
        "allowlist_tables": {
          "items": {
            "type": "string"
          },
          "title": "Allowlist Tables",
          "type": "array"
        },
        "columns_deny": {
          "items": {
            "type": "string"
          },
          "title": "Columns Deny",
          "type": "array"
        },
        "row_limit": {
          "default": 1000,
          "minimum": 1,
          "title": "Row Limit",
          "type": "integer"
        },
        "statement_timeout_s": {
          "default": 30,
          "minimum": 1,
          "title": "Statement Timeout S",
          "type": "integer"
        },
        "classification": {
          "default": "internal",
          "title": "Classification",
          "type": "string"
        },
        "schema_notes": {
          "default": "",
          "title": "Schema Notes",
          "type": "string"
        }
      },
      "required": [
        "dsn_secret"
      ],
      "title": "DataConnectionDefinition",
      "type": "object"
    },
    "DataConnectionResource": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "DataConnection",
          "title": "Kind",
          "type": "string"
        },
        "metadata": {
          "$ref": "#/$defs/Metadata"
        },
        "spec": {
          "$ref": "#/$defs/DataConnectionDefinition"
        }
      },
      "required": [
        "kind",
        "metadata",
        "spec"
      ],
      "title": "DataConnectionResource",
      "type": "object"
    },
    "DeliveryTarget": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "conversation",
            "slack",
            "teams",
            "email",
            "webhook",
            "file"
          ],
          "title": "Type",
          "type": "string"
        },
        "integration": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Integration"
        },
        "channel": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Channel"
        },
        "pre_approved": {
          "default": false,
          "title": "Pre Approved",
          "type": "boolean"
        },
        "config": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Config",
          "type": "object"
        }
      },
      "required": [
        "type"
      ],
      "title": "DeliveryTarget",
      "type": "object"
    },
    "KnowledgeCollectionDefinition": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "default": "",
          "title": "Description",
          "type": "string"
        },
        "visibility": {
          "default": "tenant",
          "enum": [
            "private",
            "team",
            "tenant"
          ],
          "title": "Visibility",
          "type": "string"
        },
        "acl_mode": {
          "default": "source",
          "enum": [
            "source",
            "collection"
          ],
          "title": "Acl Mode",
          "type": "string"
        },
        "sensitivity": {
          "default": "normal",
          "enum": [
            "normal",
            "high"
          ],
          "title": "Sensitivity",
          "type": "string"
        },
        "classification": {
          "default": "internal",
          "title": "Classification",
          "type": "string"
        },
        "embedding_alias": {
          "default": "embed",
          "title": "Embedding Alias",
          "type": "string"
        },
        "text_search_config": {
          "default": "simple",
          "enum": [
            "simple",
            "english"
          ],
          "title": "Text Search Config",
          "type": "string"
        },
        "chunk_target_tokens": {
          "default": 512,
          "minimum": 64,
          "title": "Chunk Target Tokens",
          "type": "integer"
        },
        "chunk_overlap_pct": {
          "default": 12,
          "maximum": 50,
          "minimum": 0,
          "title": "Chunk Overlap Pct",
          "type": "integer"
        },
        "contextual": {
          "default": false,
          "title": "Contextual",
          "type": "boolean"
        },
        "sources": {
          "items": {
            "$ref": "#/$defs/KnowledgeSource"
          },
          "title": "Sources",
          "type": "array"
        }
      },
      "title": "KnowledgeCollectionDefinition",
      "type": "object"
    },
    "KnowledgeCollectionResource": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "KnowledgeCollection",
          "title": "Kind",
          "type": "string"
        },
        "metadata": {
          "$ref": "#/$defs/Metadata"
        },
        "spec": {
          "$ref": "#/$defs/KnowledgeCollectionDefinition"
        }
      },
      "required": [
        "kind",
        "metadata",
        "spec"
      ],
      "title": "KnowledgeCollectionResource",
      "type": "object"
    },
