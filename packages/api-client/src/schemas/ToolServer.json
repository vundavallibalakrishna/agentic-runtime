{
  "$defs": {
    "OpenApiSpec": {
      "additionalProperties": false,
      "properties": {
        "specFile": {
          "title": "Specfile",
          "type": "string"
        },
        "baseUrl": {
          "title": "Baseurl",
          "type": "string"
        },
        "operations": {
          "items": {
            "type": "string"
          },
          "title": "Operations",
          "type": "array"
        }
      },
      "required": [
        "specFile",
        "baseUrl"
      ],
      "title": "OpenApiSpec",
      "type": "object"
    },
    "RemoteMcp": {
      "additionalProperties": false,
      "properties": {
        "url": {
          "title": "Url",
          "type": "string"
        },
        "headers": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Headers",
          "type": "object"
        }
      },
      "required": [
        "url"
      ],
      "title": "RemoteMcp",
      "type": "object"
    },
    "SqlSpec": {
      "additionalProperties": false,
      "properties": {
        "dataConnection": {
          "title": "Dataconnection",
          "type": "string"
        }
      },
      "required": [
        "dataConnection"
      ],
      "title": "SqlSpec",
      "type": "object"
    },
    "ToolAuth": {
      "additionalProperties": false,
      "properties": {
        "mode": {
          "default": "none",
          "enum": [
            "none",
            "static_secret",
            "user_oauth",
            "token_exchange",
            "internal_jwt"
          ],
          "title": "Mode",
          "type": "string"
        },
        "credentialProvider": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Credentialprovider"
        },
        "secret": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Secret"
        }
      },
      "title": "ToolAuth",
      "type": "object"
    },
    "ToolGovernance": {
      "additionalProperties": false,
      "properties": {
        "riskClass": {
          "anyOf": [
            {
              "enum": [
                "R0",
                "W1",
                "W2",
                "W3"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Riskclass"
        },
        "dataClassification": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Dataclassification"
        },
        "timeoutS": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Timeouts"
        },
        "rateLimitPerMinute": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ratelimitperminute"
        }
      },
      "title": "ToolGovernance",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "kind": {
      "enum": [
        "remote_mcp",
        "openapi",
        "sql"
      ],
      "title": "Kind",
      "type": "string"
    },
    "version": {
      "title": "Version",
      "type": "string"
    },
    "description": {
      "default": "",
      "title": "Description",
      "type": "string"
    },
    "remoteMcp": {
      "anyOf": [
        {
          "$ref": "#/$defs/RemoteMcp"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "openapi": {
      "anyOf": [
        {
          "$ref": "#/$defs/OpenApiSpec"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "sql": {
      "anyOf": [
        {
          "$ref": "#/$defs/SqlSpec"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "auth": {
      "$ref": "#/$defs/ToolAuth",
      "default": {
        "mode": "none",
        "credentialProvider": null,
        "secret": null
      }
    },
    "tools": {
      "additionalProperties": {
        "$ref": "#/$defs/ToolGovernance"
      },
      "title": "Tools",
      "type": "object"
    },
    "allowedTools": {
      "items": {
        "type": "string"
      },
      "title": "Allowedtools",
      "type": "array"
    }
  },
  "required": [
    "kind",
    "version"
  ],
  "title": "ToolServerDefinition",
  "type": "object"
}
