{
  "$defs": {
    "KnowledgeSource": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "kind": {
          "enum": [
            "upload",
            "web",
            "s3",
            "sharepoint",
            "confluence",
            "google_drive",
            "database",
            "mcp_resource"
          ],
          "title": "Kind",
          "type": "string"
        },
        "secret": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Secret"
        },
        "syncSchedule": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Syncschedule"
        },
        "aclSyncSchedule": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Aclsyncschedule"
        },
        "config": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Config",
          "type": "object"
        }
      },
      "required": [
        "name",
        "kind"
      ],
      "title": "KnowledgeSource",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "description": {
      "default": "",
      "title": "Description",
      "type": "string"
    },
    "visibility": {
      "default": "tenant",
      "enum": [
        "private",
        "team",
        "tenant"
      ],
      "title": "Visibility",
      "type": "string"
    },
    "aclMode": {
      "default": "source",
      "enum": [
        "source",
        "collection"
      ],
      "title": "Aclmode",
      "type": "string"
    },
    "sensitivity": {
      "default": "normal",
      "enum": [
        "normal",
        "high"
      ],
      "title": "Sensitivity",
      "type": "string"
    },
    "classification": {
      "default": "internal",
      "title": "Classification",
      "type": "string"
    },
    "embeddingAlias": {
      "default": "embed",
      "title": "Embeddingalias",
      "type": "string"
    },
    "textSearchConfig": {
      "default": "simple",
      "enum": [
        "simple",
        "english"
      ],
      "title": "Textsearchconfig",
      "type": "string"
    },
    "chunkTargetTokens": {
      "default": 512,
      "minimum": 64,
      "title": "Chunktargettokens",
      "type": "integer"
    },
    "chunkOverlapPct": {
      "default": 12,
      "maximum": 50,
      "minimum": 0,
      "title": "Chunkoverlappct",
      "type": "integer"
    },
    "contextual": {
      "default": false,
      "title": "Contextual",
      "type": "boolean"
    },
    "sources": {
      "items": {
        "$ref": "#/$defs/KnowledgeSource"
      },
      "title": "Sources",
      "type": "array"
    }
  },
  "title": "KnowledgeCollectionDefinition",
  "type": "object"
}
