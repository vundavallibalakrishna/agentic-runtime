{
  "$defs": {
    "AssuranceSpec": {
      "additionalProperties": false,
      "properties": {
        "recordMode": {
          "default": "off",
          "enum": [
            "off",
            "on"
          ],
          "title": "Recordmode",
          "type": "string"
        }
      },
      "title": "AssuranceSpec",
      "type": "object"
    },
    "ChannelFlags": {
      "additionalProperties": false,
      "properties": {
        "web": {
          "default": true,
          "title": "Web",
          "type": "boolean"
        },
        "slack": {
          "default": false,
          "title": "Slack",
          "type": "boolean"
        },
        "teams": {
          "default": false,
          "title": "Teams",
          "type": "boolean"
        },
        "email": {
          "default": false,
          "title": "Email",
          "type": "boolean"
        },
        "api": {
          "default": true,
          "title": "Api",
          "type": "boolean"
        },
        "widget": {
          "default": false,
          "title": "Widget",
          "type": "boolean"
        }
      },
      "title": "ChannelFlags",
      "type": "object"
    },
    "ContextSpec": {
      "additionalProperties": false,
      "properties": {
        "compactionThreshold": {
          "default": 0.7,
          "maximum": 0.9,
          "minimum": 0.4,
          "title": "Compactionthreshold",
          "type": "number"
        },
        "toolResultMaxTokens": {
          "default": 4000,
          "minimum": 1,
          "title": "Toolresultmaxtokens",
          "type": "integer"
        },
        "historyMaxMessages": {
          "default": 40,
          "minimum": 1,
          "title": "Historymaxmessages",
          "type": "integer"
        }
      },
      "title": "ContextSpec",
      "type": "object"
    },
    "KnowledgeSpec": {
      "additionalProperties": false,
      "properties": {
        "collections": {
          "items": {
            "type": "string"
          },
          "maxItems": 20,
          "title": "Collections",
          "type": "array"
        },
        "autoRetrieve": {
          "default": false,
          "title": "Autoretrieve",
          "type": "boolean"
        },
        "topK": {
          "default": 8,
          "minimum": 1,
          "title": "Topk",
          "type": "integer"
        },
        "minScore": {
          "default": 0.3,
          "maximum": 1,
          "minimum": 0,
          "title": "Minscore",
          "type": "number"
        }
      },
      "title": "KnowledgeSpec",
      "type": "object"
    },
    "MemorySpec": {
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        },
        "readScopes": {
          "items": {
            "enum": [
              "user",
              "agent",
              "team",
              "agent_user"
            ],
            "type": "string"
          },
          "title": "Readscopes",
          "type": "array"
        },
        "userWrites": {
          "default": "auto",
          "enum": [
            "auto",
            "explicit_only",
            "off"
          ],
          "title": "Userwrites",
          "type": "string"
        },
        "agentWrites": {
          "default": "review",
          "enum": [
            "review",
            "off"
          ],
          "title": "Agentwrites",
          "type": "string"
        },
        "recallTopK": {
          "default": 8,
          "minimum": 1,
          "title": "Recalltopk",
          "type": "integer"
        }
      },
      "title": "MemorySpec",
      "type": "object"
    },
    "ModelParams": {
      "additionalProperties": false,
      "properties": {
        "temperature": {
          "default": 0.2,
          "maximum": 2,
          "minimum": 0,
          "title": "Temperature",
          "type": "number"
        },
        "topP": {
          "default": 1,
          "maximum": 1,
          "minimum": 0,
          "title": "Topp",
          "type": "number"
        },
        "maxOutputTokens": {
          "default": 4096,
          "minimum": 1,
          "title": "Maxoutputtokens",
          "type": "integer"
        },
        "reasoningEffort": {
          "anyOf": [
            {
              "enum": [
                "low",
                "medium",
                "high"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reasoningeffort"
        }
      },
      "title": "ModelParams",
      "type": "object"
    },
    "ModelSpec": {
      "additionalProperties": false,
      "properties": {
        "alias": {
          "title": "Alias",
          "type": "string"
        },
        "fastAlias": {
          "default": "fast",
          "title": "Fastalias",
          "type": "string"
        },
        "visionAlias": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Visionalias"
        },
        "params": {
          "$ref": "#/$defs/ModelParams",
          "default": {
            "temperature": 0.2,
            "topP": 1.0,
            "maxOutputTokens": 4096,
            "reasoningEffort": null
          }
        },
        "degradeToFast": {
          "default": true,
          "title": "Degradetofast",
          "type": "boolean"
        }
      },
      "required": [
        "alias"
      ],
      "title": "ModelSpec",
      "type": "object"
    },
    "OutputSpec": {
      "additionalProperties": false,
      "properties": {
        "citations": {
          "default": "preferred",
          "enum": [
            "required",
            "preferred",
            "off"
          ],
          "title": "Citations",
          "type": "string"
        },
        "showReasoning": {
          "default": false,
          "title": "Showreasoning",
          "type": "boolean"
        },
        "grounding": {
          "default": "off",
          "enum": [
            "off",
            "preferred",
            "strict"
          ],
          "title": "Grounding",
          "type": "string"
        }
      },
      "title": "OutputSpec",
      "type": "object"
    },
    "Persona": {
      "additionalProperties": false,
      "properties": {
        "displayName": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Displayname",
          "type": "string"
        },
        "greeting": {
          "default": "",
          "maxLength": 500,
          "title": "Greeting",
          "type": "string"
        },
        "avatarFile": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Avatarfile"
        }
      },
      "required": [
        "displayName"
      ],
      "title": "Persona",
      "type": "object"
    },
    "RunBudget": {
      "additionalProperties": false,
      "description": "Limits for one top-level run. Subagents draw from the same budget.",
      "properties": {
        "maxSteps": {
          "minimum": 1,
          "title": "Maxsteps",
          "type": "integer"
        },
        "maxTokens": {
          "minimum": 1,
          "title": "Maxtokens",
          "type": "integer"
        },
        "maxCostMicros": {
          "minimum": 0,
          "title": "Maxcostmicros",
          "type": "integer"
        },
        "maxWallClockS": {
          "minimum": 1,
          "title": "Maxwallclocks",
          "type": "integer"
        },
        "maxToolCalls": {
          "minimum": 0,
          "title": "Maxtoolcalls",
          "type": "integer"
        },
        "maxParallelToolCalls": {
          "minimum": 1,
          "title": "Maxparalleltoolcalls",
          "type": "integer"
        }
      },
      "required": [
        "maxSteps",
        "maxTokens",
        "maxCostMicros",
        "maxWallClockS",
        "maxToolCalls",
        "maxParallelToolCalls"
      ],
      "title": "RunBudget",
      "type": "object"
    },
    "SafetySpec": {
      "additionalProperties": false,
      "properties": {
        "piiMasking": {
          "default": false,
          "title": "Piimasking",
          "type": "boolean"
        },
        "injectionClassifier": {
          "default": true,
          "title": "Injectionclassifier",
          "type": "boolean"
        }
      },
      "title": "SafetySpec",
      "type": "object"
    },
    "SandboxSpec": {
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "default": false,
          "title": "Enabled",
          "type": "boolean"
        },
        "template": {
          "default": "default",
          "title": "Template",
          "type": "string"
        },
        "scope": {
          "default": "conversation",
          "enum": [
            "conversation",
            "agent_user",
            "agent"
          ],
          "title": "Scope",
          "type": "string"
        },
        "extraEgressAllowlist": {
          "items": {
            "type": "string"
          },
          "title": "Extraegressallowlist",
          "type": "array"
        }
      },
      "title": "SandboxSpec",
      "type": "object"
    },
    "SubagentSpec": {
      "additionalProperties": false,
      "properties": {
        "allowed": {
          "items": {
            "type": "string"
          },
          "title": "Allowed",
          "type": "array"
        },
        "allowSelfClone": {
          "default": false,
          "title": "Allowselfclone",
          "type": "boolean"
        },
        "maxDepth": {
          "default": 1,
          "maximum": 3,
          "minimum": 1,
          "title": "Maxdepth",
          "type": "integer"
        },
        "maxParallel": {
          "default": 3,
          "minimum": 1,
          "title": "Maxparallel",
          "type": "integer"
        }
      },
      "title": "SubagentSpec",
      "type": "object"
    },
    "ToolBinding": {
      "additionalProperties": false,
      "properties": {
        "server": {
          "title": "Server",
          "type": "string"
        },
        "version": {
          "default": "*",
          "title": "Version",
          "type": "string"
        },
        "include": {
          "items": {
            "type": "string"
          },
          "title": "Include",
          "type": "array"
        },
        "overrides": {
          "additionalProperties": {
            "$ref": "#/$defs/ToolOverride"
          },
          "title": "Overrides",
          "type": "object"
        }
      },
      "required": [
        "server"
      ],
      "title": "ToolBinding",
      "type": "object"
    },
    "ToolOverride": {
      "additionalProperties": false,
      "properties": {
        "requireApproval": {
          "anyOf": [
            {
              "enum": [
                "always",
                "policy"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Requireapproval"
        },
        "pinned": {
          "default": false,
          "title": "Pinned",
          "type": "boolean"
        }
      },
      "title": "ToolOverride",
      "type": "object"
    },
    "ToolSearch": {
      "additionalProperties": false,
      "properties": {
        "mode": {
          "default": "auto",
          "enum": [
            "auto",
            "on",
            "off"
          ],
          "title": "Mode",
          "type": "string"
        },
        "topK": {
          "default": 12,
          "maximum": 32,
          "minimum": 4,
          "title": "Topk",
          "type": "integer"
        }
      },
      "title": "ToolSearch",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Versioned body stored in ``agent_versions.definition``.",
  "properties": {
    "persona": {
      "$ref": "#/$defs/Persona"
    },
    "instructions": {
      "maxLength": 32000,
      "minLength": 1,
      "title": "Instructions",
      "type": "string"
    },
    "starterPrompts": {
      "items": {
        "type": "string"
      },
      "maxItems": 6,
      "title": "Starterprompts",
      "type": "array"
    },
    "model": {
      "$ref": "#/$defs/ModelSpec"
    },
    "tools": {
      "items": {
        "$ref": "#/$defs/ToolBinding"
      },
      "title": "Tools",
      "type": "array"
    },
    "toolSearch": {
      "$ref": "#/$defs/ToolSearch",
      "default": {
        "mode": "auto",
        "topK": 12
      }
    },
    "knowledge": {
      "$ref": "#/$defs/KnowledgeSpec",
      "default": {
        "collections": [],
        "autoRetrieve": false,
        "topK": 8,
        "minScore": 0.3
      }
    },
    "skills": {
      "items": {
        "type": "string"
      },
      "maxItems": 50,
      "title": "Skills",
      "type": "array"
    },
    "memory": {
      "$ref": "#/$defs/MemorySpec",
      "default": {
        "enabled": true,
        "readScopes": [
          "user",
          "agent"
        ],
        "userWrites": "auto",
        "agentWrites": "review",
        "recallTopK": 8
      }
    },
    "subagents": {
      "$ref": "#/$defs/SubagentSpec",
      "default": {
        "allowed": [],
        "allowSelfClone": false,
        "maxDepth": 1,
        "maxParallel": 3
      }
    },
    "sandbox": {
      "$ref": "#/$defs/SandboxSpec",
      "default": {
        "enabled": false,
        "template": "default",
        "scope": "conversation",
        "extraEgressAllowlist": []
      }
    },
    "budget": {
      "$ref": "#/$defs/RunBudget"
    },
    "context": {
      "$ref": "#/$defs/ContextSpec",
      "default": {
        "compactionThreshold": 0.7,
        "toolResultMaxTokens": 4000,
        "historyMaxMessages": 40
      }
    },
    "output": {
      "$ref": "#/$defs/OutputSpec",
      "default": {
        "citations": "preferred",
        "showReasoning": false,
        "grounding": "off"
      }
    },
    "assurance": {
      "$ref": "#/$defs/AssuranceSpec",
      "default": {
        "recordMode": "off"
      }
    },
    "safety": {
      "$ref": "#/$defs/SafetySpec",
      "default": {
        "piiMasking": false,
        "injectionClassifier": true
      }
    },
    "channels": {
      "$ref": "#/$defs/ChannelFlags",
      "default": {
        "web": true,
        "slack": false,
        "teams": false,
        "email": false,
        "api": true,
        "widget": false
      }
    }
  },
  "required": [
    "persona",
    "instructions",
    "model",
    "budget"
  ],
  "title": "AgentDefinition",
  "type": "object"
}
