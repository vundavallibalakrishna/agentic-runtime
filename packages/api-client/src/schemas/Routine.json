{
  "$defs": {
    "DeliveryTarget": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "conversation",
            "slack",
            "teams",
            "email",
            "webhook",
            "file"
          ],
          "title": "Type",
          "type": "string"
        },
        "integration": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Integration"
        },
        "channel": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Channel"
        },
        "preApproved": {
          "default": false,
          "title": "Preapproved",
          "type": "boolean"
        },
        "config": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Config",
          "type": "object"
        }
      },
      "required": [
        "type"
      ],
      "title": "DeliveryTarget",
      "type": "object"
    },
    "RoutineTrigger": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "schedule",
            "webhook",
            "channel_event",
            "email",
            "file_arrival",
            "db_change",
            "manual"
          ],
          "title": "Type",
          "type": "string"
        },
        "cron": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cron"
        },
        "timezone": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Timezone"
        },
        "jitterS": {
          "default": 0,
          "maximum": 3600,
          "minimum": 0,
          "title": "Jitters",
          "type": "integer"
        },
        "catchupWindowS": {
          "default": 0,
          "maximum": 86400,
          "minimum": 0,
          "title": "Catchupwindows",
          "type": "integer"
        },
        "config": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Config",
          "type": "object"
        }
      },
      "required": [
        "type"
      ],
      "title": "RoutineTrigger",
      "type": "object"
    },
    "RunBudget": {
      "additionalProperties": false,
      "description": "Limits for one top-level run. Subagents draw from the same budget.",
      "properties": {
        "maxSteps": {
          "minimum": 1,
          "title": "Maxsteps",
          "type": "integer"
        },
        "maxTokens": {
          "minimum": 1,
          "title": "Maxtokens",
          "type": "integer"
        },
        "maxCostMicros": {
          "minimum": 0,
          "title": "Maxcostmicros",
          "type": "integer"
        },
        "maxWallClockS": {
          "minimum": 1,
          "title": "Maxwallclocks",
          "type": "integer"
        },
        "maxToolCalls": {
          "minimum": 0,
          "title": "Maxtoolcalls",
          "type": "integer"
        },
        "maxParallelToolCalls": {
          "minimum": 1,
          "title": "Maxparalleltoolcalls",
          "type": "integer"
        }
      },
      "required": [
        "maxSteps",
        "maxTokens",
        "maxCostMicros",
        "maxWallClockS",
        "maxToolCalls",
        "maxParallelToolCalls"
      ],
      "title": "RunBudget",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "description": {
      "default": "",
      "title": "Description",
      "type": "string"
    },
    "agent": {
      "title": "Agent",
      "type": "string"
    },
    "agentVersion": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Agentversion"
    },
    "runAs": {
      "default": "owner",
      "enum": [
        "owner",
        "service_account"
      ],
      "title": "Runas",
      "type": "string"
    },
    "serviceAccount": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Serviceaccount"
    },
    "instructions": {
      "title": "Instructions",
      "type": "string"
    },
    "trigger": {
      "$ref": "#/$defs/RoutineTrigger"
    },
    "eventFilter": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Eventfilter"
    },
    "delivery": {
      "items": {
        "$ref": "#/$defs/DeliveryTarget"
      },
      "title": "Delivery",
      "type": "array"
    },
    "budget": {
      "$ref": "#/$defs/RunBudget"
    },
    "maxRunsPerDay": {
      "default": 4,
      "minimum": 1,
      "title": "Maxrunsperday",
      "type": "integer"
    },
    "concurrencyPolicy": {
      "default": "skip",
      "enum": [
        "skip",
        "buffer_one",
        "allow"
      ],
      "title": "Concurrencypolicy",
      "type": "string"
    }
  },
  "required": [
    "agent",
    "instructions",
    "trigger",
    "budget"
  ],
  "title": "RoutineDefinition",
  "type": "object"
}
