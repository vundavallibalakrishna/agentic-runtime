{
  "uid": "ar-usage",
  "title": "Agentic Runtime Usage",
  "tags": ["agentic-runtime"],
  "schemaVersion": 39,
  "refresh": "30s",
  "time": { "from": "now-24h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Recorded cost",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(ar_run_cost_micros_total[5m]))",
          "legendFormat": "cost micros"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Quota blocks",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(ar_quota_blocks_total[5m]))",
          "legendFormat": "blocks"
        }
      ]
    }
  ]
}
