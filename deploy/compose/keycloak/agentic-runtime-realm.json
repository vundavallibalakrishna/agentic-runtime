{
  "realm": "agentic-runtime",
  "enabled": true,
  "organizationsEnabled": true,
  "loginTheme": "agentic",
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "clients": [
    {
      "clientId": "ar-web",
      "name": "Agentic Runtime web BFF",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "ar-web-dev-secret",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "protocolMappers": [
        {
          "name": "email",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "config": {
            "user.attribute": "email",
            "claim.name": "email",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "username",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "config": {
            "user.attribute": "username",
            "claim.name": "preferred_username",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "organization",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-organization-membership-mapper",
          "config": {
            "claim.name": "organization",
            "jsonType.label": "String",
            "multivalued": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ],
      "redirectUris": [
        "http://localhost:3000/*",
        "http://localhost:3001/*",
        "http://localhost:3002/*",
        "http://localhost:3003/*",
        "http://localhost:3004/*",
        "http://localhost:3005/*",
        "http://127.0.0.1:3000/*",
        "http://127.0.0.1:3001/*"
      ],
      "webOrigins": ["http://localhost:3000", "http://127.0.0.1:3000", "+"]
    },
    {
      "clientId": "ar-api",
      "name": "Agentic Runtime API",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "ar-api-dev-secret",
      "bearerOnly": true
    },
    {
      "clientId": "ar-admin",
      "name": "Agentic Runtime admin",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "ar-admin-dev-secret",
      "directAccessGrantsEnabled": true
    },
    {
      "clientId": "ar-token-exchange",
      "name": "Token exchange",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "ar-token-exchange-dev-secret",
      "standardFlowEnabled": false,
      "serviceAccountsEnabled": true
    }
  ],
  "users": [
    {
      "username": "admin@dev.local",
      "email": "admin@dev.local",
      "firstName": "Dev",
      "lastName": "Admin",
      "enabled": true,
      "emailVerified": true,
      "credentials": [{"type": "password", "value": "dev-password", "temporary": false}]
    },
    {
      "username": "builder@dev.local",
      "email": "builder@dev.local",
      "firstName": "Dev",
      "lastName": "Builder",
      "enabled": true,
      "emailVerified": true,
      "credentials": [{"type": "password", "value": "dev-password", "temporary": false}]
    },
    {
      "username": "member@dev.local",
      "email": "member@dev.local",
      "firstName": "Dev",
      "lastName": "Member",
      "enabled": true,
      "emailVerified": true,
      "credentials": [{"type": "password", "value": "dev-password", "temporary": false}]
    },
    {
      "username": "approver@dev.local",
      "email": "approver@dev.local",
      "firstName": "Dev",
      "lastName": "Approver",
      "enabled": true,
      "emailVerified": true,
      "credentials": [{"type": "password", "value": "dev-password", "temporary": false}]
    }
  ],
  "organizations": [
    {
      "name": "dev",
      "alias": "dev",
      "enabled": true,
      "domains": [{"name": "dev.local", "verified": true}]
    }
  ]
}
