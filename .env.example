# Next.js dev rewrite. Follows AR_PORT; not an AR_ catalogue variable.
API_PROXY_URL=http://127.0.0.1:8000

# Local host ports. Defaults match compose.yaml. One change updates the published
# port and the localhost URL that uses it (see docs/07-ops/local-dev.md).
AR_CLICKHOUSE_HOST_PORT=8123
AR_CLAMAV_HOST_PORT=3310
AR_EGRESS_ALLOW_LOOPBACK=true
# Leave closed egress off for local cloud-model experiments. The air-gap overlay turns it on.
AR_CA_BUNDLE=
# Directory for customer-database TLS files. Client certs and keys must live in
# <dir>/<tenant id>/. Empty refuses client certificates. sslrootcert=system stays allowed.
# Do not set this to /, /tmp, /etc or /proc.
AR_DB_CERT_DIR=
# How many resolved addresses to dial, and the overall budget in seconds.
AR_DB_MAX_ADDRESSES=4
AR_DB_CONNECT_DEADLINE_S=15
# Lowest sslmode for a customer database (disable, allow, prefer, require, verify-ca, verify-full).
# Empty imposes no floor. Closed egress uses AR_DB_STRICT_TLS.
AR_DB_MIN_SSLMODE=
# When true, closed egress requires AR_DB_STRICT_TLS_FLOOR. require is rejected.
AR_DB_STRICT_TLS=true
# verify-full checks the server name. verify-ca applies only when the host is an IP literal.
AR_DB_STRICT_TLS_FLOOR=verify-full
# Platform database services and pod CIDRs a customer DSN may not resolve to.
# Helm fills the CNPG service names. Set the pod CIDR when it is known.
AR_PLATFORM_DB_DENY_HOSTS=
AR_PLATFORM_DB_DENY_CIDRS=
AR_EGRESS_CLOSED=false
AR_EGRESS_HOSTS=
# Off until an air-gap install names a private model or connector host.
AR_EGRESS_ALLOW_NAMED_PRIVATE=false
# Empty leaves tenants.data_residency in charge. `cluster` forces a private model URL.
AR_DATA_RESIDENCY=
# Honour `*` (reach any host) in a sandbox egress allowlist. Off in production.
AR_EGRESS_ALLOW_WILDCARD=true
# Allow a sandbox without kernel isolation (docker/host). Off in production.
AR_SANDBOX_ALLOW_UNISOLATED=false
# The upload scanner: clamav or none. Production scans; dev has no scanner.
AR_FILES_SCANNER=none
AR_CLAMAV_TIMEOUT_S=10
AR_DOCUMENT_ALIGN_COSINE=0.75
AR_DOCUMENT_ALIGN_LEXICAL=0.5
